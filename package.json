{
  "name": "agora-philosophy",
  "version": "0.4.1",
  "description": "A quiet new-tab space for philosophy, economics, psychology, and personal knowledge.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "NorthGateChat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthGateChat/agora-philosophy.git"
  },
  "homepage": "https://github.com/NorthGateChat/agora-philosophy#readme",
  "bugs": {
    "url": "https://github.com/NorthGateChat/agora-philosophy/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:extension": "vite build --config vite.extension.config.ts && node scripts/finalize-extension.mjs",
    "capture:store-assets:v2:en": "node scripts/capture-store-assets-v2-en.mjs",
    "generate:store-assets:v2": "node scripts/generate-store-assets-v2.mjs",
    "capture:store-assets:v3": "node scripts/capture-store-assets-v3.mjs",
    "generate:store-assets:v3": "node scripts/generate-store-assets-v3.mjs",
    "capture:store-assets:v7": "node scripts/capture-store-assets-v7.mjs",
    "generate:store-assets:v7": "node scripts/generate-store-assets-v7.mjs",
    "validate:store-assets:v7": "node scripts/validate-store-assets-v7.mjs",
    "normalize:illustrations": "node scripts/normalize-illustration-batch.mjs",
    "validate:illustrations": "node scripts/validate-illustrations.mjs",
    "content:audit": "node --import tsx scripts/audit-source-upgrades.mjs",
    "readings:audit": "node scripts/audit-reading-units.mjs",
    "readings:fetch": "node --import tsx scripts/fetch-reading-units.mjs",
    "package:store-assets:v2": "node scripts/package-store-assets-v2.mjs",
    "package:store-assets:v3": "node scripts/package-store-assets-v3.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "test": "npm run build && npm run build:extension && node --test tests/*.test.mjs",
    "test:extension": "npm run build:extension && node --test tests/extension-package.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.11",
    "opencc-js": "1.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.28",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "type": "module"
}
